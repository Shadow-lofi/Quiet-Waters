# Web Push (broadcast notifications). Copy to .env for local dev, and set the
# same values as Environment Variables in the Vercel project for production.
# See PUSH_SETUP.md for the full walkthrough.

# VAPID keypair — generate with:  npx web-push generate-vapid-keys
# The PUBLIC key is safe to expose; the PRIVATE key is a secret (server only).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@quietwaters.app

# Reveal the push opt-in in the app. Keep unset until the backend below is wired;
# set to 1 (Vercel env, Production) to turn the Settings toggle on for everyone.
VITE_PUSH_ENABLED=

# Optional: override the public key baked into the client (defaults to the one
# embedded in src/lib/push.ts). Set only if you rotate keys.
# VITE_VAPID_PUBLIC_KEY=

# Secret you invent — required to trigger a manual announcement broadcast.
PUSH_ADMIN_TOKEN=

# Secret you invent — Vercel Cron sends it so the daily-verse endpoint can't be
# poked by anyone else.
CRON_SECRET=

# Subscription store (Vercel KV / Upstash Redis). When you add a KV store to the
# Vercel project these are injected automatically; only set them by hand for
# local testing.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
